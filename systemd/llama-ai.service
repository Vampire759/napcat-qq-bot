[Unit]
Description=本地大模型推理服务 (llama.cpp, 自动识别显卡/CPU)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/napcat-qq-bot
ExecStart=/bin/bash /opt/napcat-qq-bot/scripts/start_ai.sh
StandardOutput=append:/opt/napcat-qq-bot/logs/llama-ai.log
StandardError=append:/opt/napcat-qq-bot/logs/llama-ai.log
Restart=always
RestartSec=5
MemoryMax=12G

[Install]
WantedBy=default.target
