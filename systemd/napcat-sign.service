[Unit]
Description=NapCat 群零点打卡脚本 (scripts/group_sign.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/napcat-qq-bot
ExecStart=/usr/bin/python3 /opt/napcat-qq-bot/scripts/group_sign.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
