[Unit]
Description=Screen 会话监控 (scripts/pycreen_present.py: @查看服务/查看服务列表/查看运行服务详细状态, 仅管理员)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/napcat-qq-bot
ExecStart=/usr/bin/python3 /opt/napcat-qq-bot/scripts/pycreen_present.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
