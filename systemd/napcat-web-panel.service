[Unit]
Description=NapCat 网页管理面板 (scripts/web_panel.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/napcat-qq-bot
ExecStart=/usr/bin/python3 /opt/napcat-qq-bot/scripts/web_panel.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
